<Window x:Class="MyWpfBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Tabbed Browser" Height="650" Width="1000">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Navigation Bar -->
			<RowDefinition Height="*"/>
			<!-- Dynamic Tabs -->
		</Grid.RowDefinitions>

		<!-- Top Navigation Bar -->
		<Border Grid.Row="0" Background="#F3F3F3" Padding="6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
			<DockPanel LastChildFill="True">
				<Button x:Name="btnBack" Content="◄" Width="32" Height="30" Margin="2,0" Click="BtnBack_Click" ToolTip="Back"/>
				<Button x:Name="btnForward" Content="►" Width="32" Height="30" Margin="2,0" Click="BtnForward_Click" ToolTip="Forward"/>
				<Button x:Name="btnRefresh" Content="↻" Width="32" Height="30" Margin="2,0" Click="BtnRefresh_Click" ToolTip="Refresh"/>
				<Button x:Name="btnNewTab" Content="+" Width="32" Height="30" Margin="2,0,10,0" Click="BtnNewTab_Click" ToolTip="New Tab" FontWeight="Bold"/>

				<Button x:Name="btnGo" Content="Go" Width="50" Height="30" DockPanel.Dock="Right" Margin="4,0,0,0" Click="BtnGo_Click"/>
				<TextBox x:Name="txtAddress" Height="30" VerticalContentAlignment="Center" Padding="5,0" KeyDown="TxtAddress_KeyDown"/>
			</DockPanel>
		</Border>

		<!-- Main Tab Control -->
		<TabControl x:Name="tabControl" Grid.Row="1" SelectionChanged="TabControl_SelectionChanged" BorderThickness="0">
			<!-- Tabs are dynamically added here from C# code -->
		</TabControl>
	</Grid>
</Window>